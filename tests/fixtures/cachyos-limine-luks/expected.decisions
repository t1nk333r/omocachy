# CachyOS + Limine + LUKS, systemd/sd-encrypt HOOKS with an lvm2 HOOKS+=
# drop-in, rd.luks.uuid= cmdline, cachyos-v3 repos above [core],
# /etc/skel/.config/hypr present, linux-cachyos-lts installed.
exit=0
is_cachyos=true
reapply=false
bootloader=limine
luks=true
cmdline_crypt=systemd
captured_flavour=systemd
captured_hooks=base systemd autodetect microcode modconf kms keyboard sd-vconsole block sd-encrypt filesystems fsck lvm2
merged_hooks=base systemd plymouth keyboard autodetect microcode modconf kms sd-vconsole block sd-encrypt lvm2 filesystems fsck sd-btrfs-overlayfs
initramfs_rebuild=limine-mkinitcpio
boot_hook_policy=limine-native
skel_hypr_files=true
skel_replay=yes
refresh_limine=yes-restore-cachyos-conf
provision_user=yes
limine_default_block=TARGET_OS_NAME="CachyOS";ENABLE_UKI=no;BOOT_ORDER="*, *lts, *fallback, Snapshots";
# real-CachyOS findings (plan 017): sshd with a Port drop-in, and an
# /etc/default/limine that assigns KERNEL_CMDLINE with '=' rather than '+='.
iso_closure=cups avahi docker power-profiles-daemon kernel-modules-hook ufw ufw-docker bluez bluez-utils plocate xdg-user-dirs mise-bin chromium
ufw_ssh=allowed:22,2222
omarchy_path_env=written
limine_cmdline_style=assign-params-appended
base_packages=planned
